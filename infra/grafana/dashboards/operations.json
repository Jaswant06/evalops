{
  "uid": "evalops-ops",
  "title": "EvalOps: operations (Prometheus)",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "evalops"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Operational metrics from Prometheus: request latency, throughput, errors and resource usage of evaluation runs (pushed when a run finishes) and of the live DocQA service. Evaluation scores are on the evaluation results dashboard (PostgreSQL).",
  "panels": [
    {
      "type": "timeseries",
      "title": "Evaluation latency by version (live inference only)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (version, le) (evalops_app_request_latency_seconds_bucket{source=\"live\"}))",
          "legendFormat": "p95 {{version}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (version, le) (evalops_app_request_latency_seconds_bucket{source=\"live\"}))",
          "legendFormat": "p50 {{version}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Evaluation requests by outcome (last run per version)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version, status, source) (evalops_app_requests_total)",
          "legendFormat": "{{version}} {{status}} ({{source}})"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Evaluation run duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalops_run_duration_seconds",
          "legendFormat": "{{version}} {{dataset}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Judge calls by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version, status) (evalops_judge_calls_total)",
          "legendFormat": "{{version}} {{status}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Tokens used by the app under test",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version, direction) (evalops_app_tokens_total)",
          "legendFormat": "{{version}} {{direction}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "DocQA service: requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version, status) (rate(docqa_requests_total[5m]))",
          "legendFormat": "{{version}} {{status}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "DocQA service: latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (version, le) (rate(docqa_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{version}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (version, le) (rate(docqa_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{version}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "DocQA service: abstentions and failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (rate(docqa_abstentions_total[5m]))",
          "legendFormat": "declined {{version}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (rate(docqa_requests_total{status!=\"ok\"}[5m]))",
          "legendFormat": "failed {{version}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Model memory during live evaluation runs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalops_model_memory_bytes",
          "legendFormat": "{{model}} ({{version}})"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Share of answers generated live (rest replayed)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "evalops_run_live_fraction",
          "legendFormat": "{{version}} {{dataset}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "EvalOps API requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(evalops_api_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 11
    }
  ]
}
